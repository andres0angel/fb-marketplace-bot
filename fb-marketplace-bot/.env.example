# ============================================================
#  CONFIGURACIÓN DEL BOT - copia este archivo como .env
# ============================================================

# --- TELEGRAM ---
# Obtén este token hablando con @BotFather en Telegram
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Tu chat_id de Telegram (puedes obtenerlo con @userinfobot)
# Si son varios, separa con comas: 123456,789012
ALLOWED_CHAT_IDS=123456789
NOTIFY_CHAT_IDS=123456789

# --- FACEBOOK ---
# Opción A: Email y contraseña (recomendado con cuenta dedicada)
FB_EMAIL=tucuenta@gmail.com
FB_PASSWORD=tu_contraseña

# Opción B: Cookie de sesión (alternativa si A falla)
# Para obtenerla: abre Facebook en Chrome, F12 → Application → Cookies → c_user y xs
FB_COOKIE=

# --- COMPORTAMIENTO ---
# Cada cuántos minutos buscar automáticamente (mínimo recomendado: 30)
SEARCH_INTERVAL_MINUTES=30

# Archivo de base de datos local
DB_FILE=seen_ads.json
